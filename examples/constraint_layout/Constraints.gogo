extends Node2D
const Item = preload("Item.gd")
const Header = preload("Header.gd")
const Row = preload("Row.gd")
const Element = preload("../../../addons/estragon/runtime/composition/element.gd")
const Entry = preload("../../../addons/estragon/runtime/node/estragon_2d.gd")
const Grid = preload("../../../addons/estragon/runtime/node/grid.gd")
const VBox = preload("../../../addons/estragon/runtime/node/vbox.gd")
const Rect = preload("../../../addons/estragon/runtime/node/rect.gd")
const Text = preload("../../../addons/estragon/runtime/node/text.gd")
const Input = preload("../../../addons/estragon/runtime/node/input.gd")
@bindable var items: ArrayCollection[Item] = [{"id":1,"label":"One"},{"id":2,"label":"Two"},{"id":3,"label":"Three"},{"id":4,"label":"Four"},{"id":5,"label":"Five"},{"id":6,"label":"Six"},{"id":7,"label":"Seven"},{"id":8,"label":"Eight"},{"id":9,"label":"Nine"},{"id":10,"label":"Ten"}]
@bindable var caption: String = "Edit me"
@bindable var show_header: bool = true
var calls: int = 0
func row(value: Item) -> Element:
    return <Row key={value.id} name={"Row"+str(value.id)} item={value} />
func build_view() -> Element:
    calls += 1
    return <Entry name="UI" width="100%" height="100%">
        <Grid name="Grid" width="100%" height="100%" columns={2} rows={["auto","1fr"]} column_gap="20px" row_gap="12px">
            {<Header name="Title" row={0} column={0} /> if self.show_header else null}
            <Rect name="Fixed" row={0} column={1} width="10px" height="10px" background_color="#dd9966" />
            <VBox name="Body" row={1} column={0} column_span={2} vertical_scroll padding="20px" border_width="2px" border_color="#88aacc" background_color="#202a34" gap="6px">
                <Input name="Editor" width="140px" value={self.caption} />
                {items.map(row)}
            </VBox>
        </Grid>
    </Entry>
