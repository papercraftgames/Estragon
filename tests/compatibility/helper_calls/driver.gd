extends SceneTree
const Compiler = preload("res://addons/estragon/compiler/compiler.gd")
var _failed := false
var _checks := 0
func _initialize() -> void:
	_run.call_deferred()
func _check(value: bool, message: String) -> void:
	_checks += 1
	print("C61_CHECK ", message, ": ", value)
	if not value:
		_failed = true
		push_error("Helper calls: " + message)
func _run() -> void:
	if not OS.get_cmdline_user_args().is_empty():
		_negative(OS.get_cmdline_user_args()[0])
		return
	var source := FileAccess.get_file_as_string("res://tests/fixtures/helper-calls.gogo")
	var compiled := Compiler.compile(source, "tests/fixtures/helper-calls.gogo")
	_check(compiled.ok, "raw-free Gogo compiles")
	if not compiled.ok:
		quit(1)
		return
	var script := GDScript.new()
	script.resource_path = "res://HelperCalls.gd"
	script.source_code = compiled.code
	_check(script.reload() == OK, "generated native code reloads")
	var instance = script.new()
	var first = instance.instance_lambda()
	_check(first is EstragonRect and first.width == 7.0, "instance lambda returns actual component")
	if first == null:
		quit(1)
		return
	_check(instance.initial.width == 2.0 and instance.initial.height == 3.0, "member initializer")
	_check(instance.initializer_callback.call().width == 4.0, "initializer lambda")
	_check(script.static_method().width == 9.0, "static method")
	_check(script.static_lambda().width == 8.0, "static lambda retains captured local")
	_check(instance.direct_method().text == "direct", "direct instance method")
	_check(instance.nested_lambdas().width == 10.0, "nested lambdas retain captured argument")
	var nested = instance.nested()
	_check(nested.gap == 1.0 and nested.get_children()[0].width == 2.0 and nested.get_children()[1].width == 3.0, "nested lambda expressions execute")
	_check(instance.events == [1, 2, 3], "authored eager evaluation order")
	var button = instance.button()
	var callbacks: Array = button.pressed.get_connections()
	_check(callbacks.size() == 1 and callbacks[0].callable == Callable(instance, "on_pressed"), "original callback identity")
	button.pressed.emit()
	_check(instance.events == [1, 2, 3, 4], "lambda-built button invokes handler")
	var owner := EstragonContainer.new()
	owner.add_child(button)
	owner.remove_child(button)
	_check(button.is_disposed() and button.pressed.get_connections().is_empty(), "normal ownership cleans callback")
	var repeat := Compiler.compile(source, "tests/fixtures/helper-calls.gogo")
	_check(repeat.code == compiled.code and repeat.source_map.serialize() == compiled.source_map.serialize(), "deterministic generated bytes/maps")
	for segment in compiled.source_map.segments:
		if segment.kind == "copied":
			_check(compiled.code.substr(segment.generated.start.index, segment.generated.end.index - segment.generated.start.index) == source.substr(segment.original.start.index, segment.original.end.index - segment.original.start.index), "authored source range copied exactly")
	var lines := compiled.code.split("\n")
	var mapped := false
	for line in range(lines.size()):
		if lines[line].contains("return _GogoFactories_1."):
			var point = compiled.source_map.original_position(line + 1, lines[line].find("_GogoFactories_1.") + 1)
			_check(point != null and source.split("\n")[point.line - 1].contains("<"), "qualified call maps to original component")
			mapped = true
	_check(mapped, "qualified namespace collision avoided and source map exercised")
	_inheritance()
	print("C61_ASSERTIONS ", _checks)
	if not _failed: print("C61_HELPER_CALLS_OK")
	quit(1 if _failed else 0)

func _negative(mode: String) -> void:
	var expression := '<Rect width={"wrong"}/>' if mode == "argument" else '<Rect width={1.0}/>'
	var source := "extends RefCounted\nfunc invoke():\n    var callback: Callable = func() -> " + ("EstragonRect" if mode == "argument" else "int") + ":\n        return " + expression + "\n    return callback.call()\n"
	var compiled := Compiler.compile(source, "Negative.gogo")
	_check(compiled.ok, "negative frontend compiles before native typing")
	var script := GDScript.new()
	script.resource_path = "res://Negative.gd"
	script.source_code = compiled.code
	_check(script.reload() == ERR_PARSE_ERROR, "native typed " + mode + " rejection remains")
	var mapped = compiled.source_map.original_position(4)
	_check(mapped != null and mapped.line == 4, "native rejection line maps to authored callback")
	print("C61_NEGATIVE_", mode.to_upper(), "_OK" if not _failed else "_FAIL")
	quit(1 if _failed else 0)

func _inheritance() -> void:
	var base_source := "extends RefCounted\nfunc base_view(): return <Rect width={6.0}/>\n"
	var base := Compiler.compile(base_source, "Base.gogo")
	var file := FileAccess.open("res://Base.gd", FileAccess.WRITE)
	file.store_string(base.code)
	file.close()
	var base_script = load("res://Base.gd")
	_check(base_script != null and base_script.can_instantiate(), "base generated class validates")
	var derived := Compiler.compile('extends "Base.gd"\nfunc derived_view(): return <Text text={"derived"}/>\n', "Derived.gogo")
	var script := GDScript.new()
	script.resource_path = "res://Derived.gd"
	script.source_code = derived.code
	_check(script.reload() == OK, "derived generated namespace preserves inheritance")
	if script.can_instantiate():
		var instance = script.new()
		_check(instance.base_view().width == 6.0 and instance.derived_view().text == "derived", "inherited and derived factories retain own identity")
