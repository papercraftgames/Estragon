ame=\"Greeting\">Hello {self.username}!</Text>\n\t\t\t<Text name=\"Quote\">I'm \"native\", é 🌱.</Text>\n\t\t\t<Text name=\"Multiline\">\n\t\t\t\tOne word\n\t\t\t\tanother line\n\t\t\t</Text>\n\t\t\t<Text name=\"Boundaries\">\n\t\t\t\tHello\n\t\t\t\t{self.username}\n\t\t\t\tworld\n\t\t\t</Text>\n\t\t\t<Text name=\"Expressions\">{self.label}\n\t\t\t\t{self.username}</Text>\n\t\t\t<Text name=\"Empty\"></Text>\n\t\t\t<Text name=\"Strict\">{body_value()}</Text>\n\t\t\t<HBox name=\"Wrapped\" {...{\"wrap\":false}} wrap>\n\t\t\t\t<Button name=\"Native\" pressed={pressed}>{self.label}</Button>\n\t\t\t\t<UiButton name=\"Custom\" pressed={pressed}>Also click me</UiButton>\n\t\t\t\t<UiButton name=\"Disabled\" disabled>Disabled</UiButton>\n\t\t\t</HBox>\n\t\t\t<HBox name=\"Override\" wrap {...{\"wrap\":false}} />\n\t\t\t<Text name=\"Spread\" {...self.extra}>Body</Text>\n\t\t</VBox>\n\t</Entry2D>\n","sourceName":"examples/ux01/Ergonomics.gogo","version":1}
