}},{"generated":{"end":{"column":1,"line":96,"offset":4713},"start":{"column":1,"line":95,"offset":4503}},"kind":"generated","original":{"end":{"column":20,"line":29,"offset":1702},"start":{"column":13,"line":26,"offset":1436}}},{"generated":{"end":{"column":1,"line":97,"offset":4969},"start":{"column":1,"line":96,"offset":4713}},"kind":"generated","original":{"end":{"column":16,"line":30,"offset":1718},"start":{"column":9,"line":18,"offset":826}}},{"generated":{"end":{"column":1,"line":98,"offset":5161},"start":{"column":1,"line":97,"offset":4969}},"kind":"generated","original":{"end":{"column":13,"line":31,"offset":1731},"start":{"column":12,"line":17,"offset":761}}},{"generated":{"end":{"column":1,"line":99,"offset":5192},"start":{"column":1,"line":98,"offset":5161}},"kind":"generated","original":{"end":{"column":13,"line":31,"offset":1731},"start":{"column":12,"line":17,"offset":761}}}],"sourceContent":"extends Node2D\nconst Element = preload(\"../../../addons/estragon/runtime/composition/element.gd\")\nconst Entry = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst HBox = preload(\"../../../addons/estragon/runtime/node/hbox.gd\")\nconst Rect = preload(\"../../../addons/estragon/runtime/node/rect.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\n@bindable var count: int = 0\nvar ui: Node:\n    get: return get_node_or_null(\"UI\")\n\nfunc _ready() -> void:\n    if OS.get_environment(\"ESTRAGON_C3_PROOF\") == \"1\": write_proof.call_deferred()\n\nfunc build_view() -> Element:\n    return <Entry name=\"UI\" position={Vector2(24,24)} width=\"90vw\">\n        <VBox name=\"Panel\" width=\"100%\" gap={16.0}>\n            <Rect name=\"Accent\" height={8.0} width=\"100%\" fill={Color(0.2,0.8,0.6)} />\n            <Text name=\"Title\" text=\"Estragon native Gogo Counter\" font_size={28} color={Color(0.74,0.64,0.94)} />\n            <Text name=\"Count\" text={\"Count: %d\" % self.count} font_size={26} />\n            <HBox name=\"Actions\" width=\"100%\" gap={12.0}>\n                <Button name=\"Increment\" text=\"+\" grow={1} pressed={increment} />\n                <Button name=\"Reset\" text=\"Reset\" grow={1} disabled={self.count == 0} pressed={reset_count} />\n            </HBox>\n            <VBox name=\"Details\" width=\"100%\" gap={6.0}>\n                <Text name=\"Hint\" text=\"Click + to update retained Nodes.\" font_size={18} />\n                <Text name=\"Resize\" text=\"Resize the window: nested native stacks reflow.\" font_size={18} />\n            </VBox>\n        </VBox>\n    </Entry>\n\nfunc increment() -> void:\n    count += 1\n\nfunc reset_count() -> void:\n    count = 0\n\nfunc write_proof() -> void:\n    await get_tree().process_frame\n    await get_tree().process_frame\n    var file := FileAccess.open(\"res://.godot/c3-play.json\",FileAccess.WRITE)\n    file.store_string(JSON.stringify({\"count\":count,\"text\":ui.get_node(\"Panel/Count\").text,\"native\":ui.get_layout_root()==ui}))\n","sourceName":"examples/counter/Counter.gogo","version":1}
