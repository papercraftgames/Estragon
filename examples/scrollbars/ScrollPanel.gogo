extends Node2D
const Element = preload("../../../addons/estragon/runtime/composition/element.gd")
const Box = preload("../../../addons/estragon/runtime/node/box.gd")
const Button = preload("../../../addons/estragon/runtime/node/button.gd")
func build_view() -> Element:
    return <Box name="Panel" wrap width="100%" column_gap="8px" row_gap="8px" background_color="#535353">
        <Button width="186px" text="First action" />
        <Button width="186px" text="Right edge action" />
        <Button width="186px" text="Next line" />
    </Box>
