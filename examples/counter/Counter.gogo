extends Node2D
const Element = preload("../../../addons/estragon/runtime/composition/element.gd")
const Entry = preload("../../../addons/estragon/runtime/node/estragon_2d.gd")
const VBox = preload("../../../addons/estragon/runtime/node/vbox.gd")
const HBox = preload("../../../addons/estragon/runtime/node/hbox.gd")
const Rect = preload("../../../addons/estragon/runtime/node/rect.gd")
const Text = preload("../../../addons/estragon/runtime/node/text.gd")
const UiButton = preload("../../../addons/estragon/runtime/node/button.gd")
@bindable var count: int = 0
var ui: Node:
    get: return get_node_or_null("UI")

func _ready() -> void:
    if OS.get_environment("ESTRAGON_C3_PROOF") == "1": write_proof.call_deferred()

func build_view() -> Element:
    return <Entry name="UI" position={Vector2(24,24)} width="90vw">
        <VBox name="Panel" width="100%" gap={16.0}>
            <Rect name="Accent" height={8.0} width="100%" fill={Color(0.2,0.8,0.6)} />
            <Text name="Title" text="Estragon native Gogo Counter" font_size={28} color={Color(0.74,0.64,0.94)} />
            <Text name="Count" text={"Count: %d" % self.count} font_size={26} />
            <HBox name="Actions" width="100%" gap={12.0}>
                <UiButton name="Increment" text="+" flex={1} pressed={increment} />
                <UiButton name="Reset" text="Reset" flex={1} disabled={self.count == 0} pressed={reset_count} />
            </HBox>
            <VBox name="Details" width="100%" gap={6.0}>
                <Text name="Hint" text="Click + to update retained Nodes." font_size={18} />
                <Text name="Resize" text="Resize the window: nested native stacks reflow." font_size={18} />
            </VBox>
        </VBox>
    </Entry>

func increment() -> void:
    count += 1

func reset_count() -> void:
    count = 0

func write_proof() -> void:
    await get_tree().process_frame
    await get_tree().process_frame
    var file := FileAccess.open("res://.godot/c3-play.json",FileAccess.WRITE)
    file.store_string(JSON.stringify({"count":count,"text":ui.get_node("Panel/Count").text,"native":ui.get_layout_root()==ui}))
