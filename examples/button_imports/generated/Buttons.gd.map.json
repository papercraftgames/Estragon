304}},"kind":"generated","original":{"end":{"column":57,"line":39,"offset":2285},"start":{"column":4,"line":39,"offset":2232}}},{"generated":{"end":{"column":1,"line":110,"offset":6745},"start":{"column":1,"line":109,"offset":6477}},"kind":"generated","original":{"end":{"column":10,"line":40,"offset":2295},"start":{"column":3,"line":29,"offset":1474}}},{"generated":{"end":{"column":1,"line":111,"offset":7005},"start":{"column":1,"line":110,"offset":6745}},"kind":"generated","original":{"end":{"column":12,"line":41,"offset":2307},"start":{"column":9,"line":28,"offset":1367}}},{"generated":{"end":{"column":1,"line":112,"offset":7030},"start":{"column":1,"line":111,"offset":7005}},"kind":"generated","original":{"end":{"column":12,"line":41,"offset":2307},"start":{"column":9,"line":28,"offset":1367}}}],"sourceContent":"extends Node2D\nconst Element = preload(\"../../../addons/estragon/runtime/composition/element.gd\")\nconst Entry2D = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst HBox = preload(\"../../../addons/estragon/runtime/node/hbox.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nconst Toggle = preload(\"../../../addons/estragon/runtime/node/toggle.gd\")\nconst NativeButton = preload(\"../../godot_button.gd\")\nconst NativeOnly = preload(\"NativeOnly.gd\")\nconst TypedButton = preload(\"TypedButton.gd\")\nconst PANEL_TEXTURE = preload(\"../../surfaces/panel_gradient.tres\")\nconst AnotherButton = Button\n@bindable var checked: bool = false\n@bindable var props: Dictionary = {}\n@bindable var selected: Button = null\nvar clicks: int = 0\nvar native_clicks: int = 0\nfunc pressed(): clicks += 1\nfunc native_pressed(): native_clicks += 1\nfunc typed(value: Button) -> Button: return value\nfunc constructors() -> Array:\n\treturn [Button.new(),AnotherButton.new(),NativeButton.new(),ClassDB.instantiate(\"Button\")]\nfunc member_and_string() -> String:\n\tvar object := {\"Button\":\"Button member\"}\n\treturn object.Button # Button is data here, not the imported identifier.\nfunc build_view() -> Element:\n\treturn <Entry2D name=\"UI\" width=\"100%\" height=\"100%\" padding=\"12px\" background_color=\"#171b24\" vertical_scroll>\n\t\t<VBox name=\"Column\" width=\"100%\" gap=\"8px\">\n\t\t\t<Text>Import-selected Button</Text>\n\t\t\t<HBox name=\"Kinds\" wrap gap=\"8px\">\n\t\t\t\t<Button name=\"Action\" text=\"Estragon Button\" width=\"180px\" height=\"56px\" pressed={pressed} {...self.props} />\n\t\t\t\t<NativeButton name=\"Native\" text=\"Native script alias\" pressed={native_pressed} />\n\t\t\t\t<NativeOnly name=\"Unimported\" />\n\t\t\t</HBox>\n\t\t\t<Button name=\"Disabled\" disabled width=\"180px\" height=\"56px\">Disabled charcoal</Button>\n\t\t\t<Toggle name=\"Toggle\" width=\"180px\" height=\"56px\" bind:value={self.checked}>Teal when checked</Toggle>\n\t\t\t<Button name=\"Surface\" width=\"240px\" height=\"72px\" corner_radius=\"18px\" background_color=\"#283842\" background_texture={PANEL_TEXTURE} pressed={pressed}>Explicit native surface</Button>\n\t\t\t<TypedButton name=\"Typed\" supplied={self.selected} />\n\t\t</VBox>\n\t</Entry2D>\n","sourceName":"examples/button_imports/Buttons.gogo","version":1}
