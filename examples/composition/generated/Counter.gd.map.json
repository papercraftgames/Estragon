nerated":{"end":{"column":1,"line":101,"offset":4349},"start":{"column":1,"line":100,"offset":4161}},"kind":"generated","original":{"end":{"column":95,"line":22,"offset":1281},"start":{"column":13,"line":22,"offset":1199}}},{"generated":{"end":{"column":1,"line":102,"offset":4566},"start":{"column":1,"line":101,"offset":4349}},"kind":"generated","original":{"end":{"column":16,"line":23,"offset":1297},"start":{"column":9,"line":17,"offset":830}}},{"generated":{"end":{"column":1,"line":103,"offset":4753},"start":{"column":1,"line":102,"offset":4566}},"kind":"generated","original":{"end":{"column":13,"line":24,"offset":1310},"start":{"column":12,"line":16,"offset":751}}},{"generated":{"end":{"column":1,"line":104,"offset":4778},"start":{"column":1,"line":103,"offset":4753}},"kind":"generated","original":{"end":{"column":13,"line":24,"offset":1310},"start":{"column":12,"line":16,"offset":751}}}],"sourceContent":"extends Node2D\nconst Element = preload(\"res://addons/estragon/runtime/composition/element.gd\")\nconst Entry = preload(\"res://addons/estragon/runtime/node/estragon_2d.gd\")\nconst VBox = preload(\"res://addons/estragon/runtime/node/vbox.gd\")\nconst Text = preload(\"res://addons/estragon/runtime/node/text.gd\")\nconst Rect = preload(\"res://addons/estragon/runtime/node/rect.gd\")\nconst UiButton = preload(\"res://addons/estragon/runtime/node/button.gd\")\nconst Model = preload(\"res://examples/composition/generated/Model.gd\")\n@bindable var count: int = 0\n@bindable var unused: int = 0\n@bindable var model: Model = Model.new()\nfunc heading() -> String:\n    return model.title\nfunc build_view() -> Element:\n    var caption: String = \"Count: %d\" % count\n    return <Entry name=\"UI\" position={Vector2(24,24)} viewport_width_scale={0.9}>\n        <VBox name=\"Panel\" fill_width={true} gap={12.0}>\n            <Text name=\"Title\" text={heading()} color={Color(0.74,0.64,0.94)} />\n            <Text name=\"Count\" text={caption} />\n            <Rect name=\"Bar\" width={model.width + count * 10.0} height={10.0} fill={Color(0.2,0.8,0.6)} />\n            <UiButton name=\"Increment\" text=\"+\" pressed={increment} />\n            <UiButton name=\"Reset\" text=\"Reset\" disabled={count == 0} pressed={reset_count} />\n        </VBox>\n    </Entry>\nfunc increment() -> void:\n    count += 1\nfunc reset_count() -> void:\n    count = 0\nfunc _ready() -> void:\n    if OS.get_environment(\"ESTRAGON_COMPOSITION_PROOF\") == \"1\": write_proof.call_deferred()\nfunc write_proof() -> void:\n    for index in range(5): await get_tree().process_frame\n    var file := FileAccess.open(\"res://.godot/composition-play.json\",FileAccess.WRITE)\n    file.store_string(JSON.stringify({\"count\":count,\"text\":get_node(\"UI/Panel/Count\").text}))\n","sourceName":"examples/composition/Counter.gogo","version":1}
