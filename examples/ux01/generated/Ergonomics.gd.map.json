ffset":1653}}},{"generated":{"end":{"column":1,"line":127,"offset":7693},"start":{"column":1,"line":126,"offset":7380}},"kind":"generated","original":{"end":{"column":10,"line":44,"offset":1710},"start":{"column":3,"line":21,"offset":911}}},{"generated":{"end":{"column":1,"line":128,"offset":7857},"start":{"column":1,"line":127,"offset":7693}},"kind":"generated","original":{"end":{"column":12,"line":45,"offset":1722},"start":{"column":9,"line":20,"offset":872}}},{"generated":{"end":{"column":1,"line":129,"offset":7882},"start":{"column":1,"line":128,"offset":7857}},"kind":"generated","original":{"end":{"column":12,"line":45,"offset":1722},"start":{"column":9,"line":20,"offset":872}}}],"sourceContent":"extends Node2D\nconst Element = preload(\"../../../addons/estragon/runtime/composition/element.gd\")\nconst Entry2D = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst HBox = preload(\"../../../addons/estragon/runtime/node/hbox.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nconst NativeButton = preload(\"../../godot_button.gd\")\n@bindable var username: String = \"é 🌱\"\n@bindable var label: String = \"Click Me\"\n@bindable var extra: Dictionary = {}\n@bindable var bad_text: bool = false\nvar evaluations: int = 0\nfunc body_value() -> Variant:\n\tevaluations += 1\n\treturn 42 if self.bad_text else \"Strict\"\nvar clicks: int = 0\nfunc pressed(): clicks += 1\nfunc build_view() -> Element:\n\treturn <Entry2D width=\"100%\" height=\"100%\">\n\t\t<VBox width=\"100%\" gap=\"12px\">\n\t\t\t<Text name=\"Greeting\">Hello {self.username}!</Text>\n\t\t\t<Text name=\"Quote\">I'm \"native\", é 🌱.</Text>\n\t\t\t<Text name=\"Multiline\">\n\t\t\t\tOne word\n\t\t\t\tanother line\n\t\t\t</Text>\n\t\t\t<Text name=\"Boundaries\">\n\t\t\t\tHello\n\t\t\t\t{self.username}\n\t\t\t\tworld\n\t\t\t</Text>\n\t\t\t<Text name=\"Expressions\">{self.label}\n\t\t\t\t{self.username}</Text>\n\t\t\t<Text name=\"Empty\"></Text>\n\t\t\t<Text name=\"Strict\">{body_value()}</Text>\n\t\t\t<HBox name=\"Wrapped\" {...{\"wrap\":false}} wrap>\n\t\t\t\t<NativeButton name=\"Native\" pressed={pressed}>{self.label}</NativeButton>\n\t\t\t\t<Button name=\"Custom\" pressed={pressed}>Also click me</Button>\n\t\t\t\t<Button name=\"Disabled\" disabled>Disabled</Button>\n\t\t\t</HBox>\n\t\t\t<HBox name=\"Override\" wrap {...{\"wrap\":false}} />\n\t\t\t<Text name=\"Spread\" {...self.extra}>Body</Text>\n\t\t</VBox>\n\t</Entry2D>\n","sourceName":"examples/ux01/Ergonomics.gogo","version":1}
