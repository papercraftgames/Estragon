extends Node2D
const Element = preload("../../../addons/estragon/runtime/composition/element.gd")
const Entry2D = preload("../../../addons/estragon/runtime/node/estragon_2d.gd")
const HBox = preload("../../../addons/estragon/runtime/node/hbox.gd")
const VBox = preload("../../../addons/estragon/runtime/node/vbox.gd")
const Grid = preload("../../../addons/estragon/runtime/node/grid.gd")
const Text = preload("../../../addons/estragon/runtime/node/text.gd")
const Rect = preload("../../../addons/estragon/runtime/node/rect.gd")
const Button = preload("../../../addons/estragon/runtime/node/button.gd")
const NativeButton = preload("../../godot_button.gd")
const Toggle = preload("../../../addons/estragon/runtime/node/toggle.gd")
@bindable var order: Array = ["a","b","c","d","e","f"]
@bindable var show_extra: bool = true
@bindable var enabled: bool = false
@bindable var grid_props: Dictionary = {"columns":["140px","1fr"],"rows":["48px","auto"],"areas":["header header","sidebar main"]}
@bindable var header_props: Dictionary = {}
@bindable var placement: Dictionary = {"area":"main"}
var clicks: int = 0
var native_clicks: int = 0
var edits: Array = []
func pressed() -> void: clicks += 1
func native_pressed() -> void: native_clicks += 1
func edited(value: bool) -> void: edits.append(value)
func card(value: String) -> Element:
	return <Button key={value} name={value} text={"Card "+value} width="120px" height="36px" pressed={pressed} />
func build_view() -> Element:
	return <Entry2D name="UI" width="100%" height="100%" padding="12px" background_color="#171b24">
		<VBox name="Content" width="100%" gap="12px" horizontal_align="stretch">
			<Text text="Responsive Wrap + Grid" color={Color("#ffc65c")} />
			<HBox name="Cards" width="100%" wrap={true} gap="10px" row_gap="12px" horizontal_align="space-between" vertical_align="center">
				{self.order.map(card)}
			</HBox>
			<Grid name="Named" width="100%" gap="10px" padding="10px" border_width="2px" border_color="#8295bc" background_color="#252b38" {...self.grid_props}>
				<NativeButton name="Header" area="header" text="Native tracks" {...self.header_props} />
				<VBox name="Sidebar" area="sidebar" gap="8px">
					<Toggle name="Enabled" text="Enabled" bind:value={self.enabled} />
					<NativeButton name="Native" text="Native Control" pressed={native_pressed} />
				</VBox>
				<NestedResponsive name="Main" {...self.placement} />
			</Grid>
			<Grid name="Automatic" columns={3} width="100%" gap="10px" background_color="#30394d">
				<Rect name="One" height="20px" background_color="#477dbb" />
				<Rect name="Two" height="28px" background_color="#ffc65c" />
				<Rect name="Three" height="20px" background_color="#477dbb" />
				<NativeButton name="Fourth" text="Native cell" pressed={native_pressed} />
				{<Text key="extra" name="Extra" text="Row 2" /> if self.show_extra else null}
				{get_children()}
			</Grid>
		</VBox>
	</Entry2D>
