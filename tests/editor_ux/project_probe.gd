extends SceneTree
const Build = preload("res://addons/estragon/editor/build_service.gd")
const Compiler = preload("res://addons/estragon/compiler/compiler.gd")
const Completion = preload("res://addons/estragon/editor/completion.gd")
const Context = preload("res://addons/estragon/editor/lexical_context.gd")
const Fixture = preload("project_fixture.gd")
var failed := false
var checks := 0
func check(value: bool, label: String) -> void:
	checks += 1
	print("E07_CHECK ",label,": ",value)
	if not value: failed = true
func _initialize() -> void: _run.call_deferred()
func frames() -> void:
	for index in range(10): await process_frame
func rejected(text: String, message: String) -> void:
	Fixture.write(Fixture.HOME,text)
	var output: String = Build.output_for(Fixture.HOME)
	var bytes := FileAccess.get_file_as_bytes(output)
	var maps := FileAccess.get_file_as_bytes(output+".map.json")
	var stamp := FileAccess.get_modified_time(output)
	var script = load(output)
	var report := Build.run_build()
	check(not report.ok and str(report.diagnostics).contains(message),message+" rejected with diagnostic")
	check(not report.source_diagnostics.is_empty() and report.source_diagnostics.any(func(d): return str(d.source).ends_with("Home.gogo")),"authored diagnostic for "+message)
	check(FileAccess.get_file_as_bytes(output)==bytes and FileAccess.get_file_as_bytes(output+".map.json")==maps and FileAccess.get_modified_time(output)==stamp and load(output)==script,"rollback/identity for "+message)
	Fixture.write(Fixture.HOME,Fixture.home())
func _run() -> void:
	Fixture.install()
	check(not FileAccess.file_exists(Build.output_for(Fixture.SETTINGS)),"cold source discovery before generated Settings exists")
	var direct := Compiler.compile(Fixture.home(),Fixture.HOME,Build.output_for(Fixture.HOME))
	check(direct.ok and direct.code.contains('preload("Settings.gd")') and not Fixture.home().contains("const Settings"),"manually typed project tag lowers without editor/import action")
	var report := Build.run_build()
	print("E07_BUILD ",report)
	check(report.ok,"fresh coherent dependency build")
	if not report.ok: finish(); return
	var output: String = Build.output_for(Fixture.HOME)
	var identity = load(output)
	var before := FileAccess.get_file_as_bytes(output)
	var stamp := FileAccess.get_modified_time(output)
	check(Build.run_build().ok and FileAccess.get_modified_time(output)==stamp and load(output)==identity,"no-op build retains timestamp and Script identity")
	var host: Node = identity.new()
	root.add_child(host)
	await frames()
	var child := host.get_node_or_null("UI/Column/SettingsChild")
	check(child != null and child.get_node_or_null("SettingsView/Leaf/LeafView")!=null,"nested Gogo child build_view actually mounts")
	if child == null: host.free(); finish(); return
	var caption := child.get_node("SettingsView/Caption")
	check(caption.text=="Settings child" and caption.layout_size.x>0,"child explicit Entry supplies rendered layout")
	var unscoped := host.get_node("UI/Column/BoundaryChild/Unscoped")
	check(unscoped.layout_size==Vector2.ZERO,"plain Gogo Node2D stops inherited layout scope")
	var id := child.get_instance_id()
	host.tick = 1
	await frames()
	check(host.get_node("UI/Column/SettingsChild").get_instance_id()==id and host.get_node("UI/Column/Greeting").text=="Hello World! 1","unrelated parent update retains child identity")
	child.title = "Updated child"
	await frames()
	check(child.get_node("SettingsView/Caption")==caption and caption.text=="Updated child","nested bindable child recomposes with retained native Text")
	child.changed.emit(true)
	check(host.received,"typed child signal invokes native parent handler")
	var child_ref: WeakRef = weakref(child)
	var state = load("res://addons/estragon/runtime/composition/state.tres")
	host.free()
	await frames()
	check(child_ref.get_ref()==null and not state.records.has(id),"nested ownership/subscriptions disposed on native removal")
	var spatial: Node = load("res://app/Screens/generated/Spatial.gd").new()
	root.add_child(spatial)
	await frames()
	check(spatial.get_node_or_null("SpatialChild/SpatialView") is Node3D,"3D source siblings actually mount")
	spatial.free()
	var completion := Completion.new()
	var options: Array = completion.candidates('extends Node2D\nfunc view(): return <Sett',Fixture.HOME,Context.new(),1,26)
	check(options.any(func(item): return item.text.begins_with("Settings — Gogo Component") and item.text.contains(Fixture.SETTINGS)),"source-aware project tag completion")
	check(completion.import_plan(Fixture.home(),Fixture.HOME).text.contains('const Settings = preload("Settings.gd")'),"Add Missing Imports handles manually authored project tag")
	check(completion.definition(Fixture.home(),Fixture.HOME,"Settings")==Fixture.SETTINGS,"project definition opens authored source")
	rejected(Fixture.home().replace('<Settings name=', '<Unknown name='),"Unknown Node GGX component")
	rejected(Fixture.home().replace('func build_view()', 'var Settings: int = 3\nfunc build_view()'),"Ambiguous project Gogo component")
	var duplicate := "res://app/Other/Settings.gogo"
	Fixture.write(duplicate,Fixture.settings(duplicate))
	rejected(Fixture.home(),"Ambiguous project Gogo component")
	var alias: String = preload("res://addons/estragon/editor/imports.gd").declaration("Settings",Build.output_for(Fixture.SETTINGS),Fixture.HOME)
	Fixture.write(Fixture.HOME,Fixture.home().replace("func build_view()",alias+"func build_view()"))
	check(Build.run_build().ok,"explicit alias remains authoritative with duplicate filenames")
	DirAccess.remove_absolute(duplicate)
	Fixture.write(Fixture.HOME,Fixture.home())
	Fixture.write(Fixture.LEAF,Fixture.header(Fixture.LEAF,"Node2D",["Element"])+"func build_view() -> Element:\n\treturn <Home />\n")
	rejected(Fixture.home(),"Cyclic Gogo/source preload dependency")
	Fixture.write(Fixture.LEAF,Fixture.leaf())
	rejected(Fixture.home().replace('<Settings name=', '<Home name='),"Self-reference")
	DirAccess.rename_absolute(Fixture.SETTINGS,"res://app/Screens/Preferences.gogo")
	rejected(Fixture.home(),"Unknown Node GGX component")
	DirAccess.rename_absolute("res://app/Screens/Preferences.gogo",Fixture.SETTINGS)
	Fixture.write(Fixture.SETTINGS,"extends Node2D\nfunc view(): return <Node2D>\n")
	rejected(Fixture.home(),"Invalid authored Gogo component metadata")
	Fixture.write(Fixture.SETTINGS,"extends Node2D\nfunc _init(value: int):\n\tposition.x = value\n")
	rejected(Fixture.home(),"zero-argument initializer")
	Fixture.write(Fixture.SETTINGS,"extends RefCounted\n")
	rejected(Fixture.home(),"constructible Node")
	Fixture.write(Fixture.SETTINGS,Fixture.settings())
	Fixture.write(Fixture.HOME,Fixture.home())
	check(Build.run_build().ok,"repair restores coherent build")
	DirAccess.remove_absolute(Build.output_for(Fixture.SETTINGS))
	check(Build.run_build().ok and FileAccess.file_exists(Build.output_for(Fixture.SETTINGS)),"regenerates missing dependency through native transaction")
	finish()
func finish() -> void:
	print("E07_ASSERTIONS ",checks," failed=",failed)
	if not failed: print("E07_PROJECT_OK")
	quit(1 if failed else 0)
