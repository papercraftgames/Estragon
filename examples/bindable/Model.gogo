@bindable
class_name BindableExampleModel
extends RefCounted
## Typed non-Node data; GGX and UI dependency bindings are unnecessary here.
@bindable var count: int = 3
var title: String = "Model"
var items: Array[int] = []
var peer: RefCounted = null
var amount: float = 0.0
func increment() -> void:
    count += 1
