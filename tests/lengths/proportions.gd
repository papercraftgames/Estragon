extends SceneTree
const Core = preload("res://addons/estragon/runtime/node/internal/layout_core.gd")
const Length = preload("res://addons/estragon/runtime/node/internal/length.gd")
var checks := 0
var failed := false
func check(value: bool,label: String):
	checks += 1
	failed = failed or not value
	print("L12_PERCENT ",label,": ",value)
func near(a: float,b: float) -> bool: return absf(a-b)<0.001
func model(values: Dictionary={},axis: int=0,content: Vector3=Vector3.ZERO):
	var node = Core.new()
	node.configure(Vector3(-1,-1,-1),0,false,axis,Vector3.ZERO,content)
	var specs := {}
	for key in values: specs[key] = Length.parse(values[key],Length.domain(key))
	node.set_lengths(specs,0,0,1,axis)
	return node
func layout(node,reference: Vector3=Vector3(300,300,-1),viewport: Vector2=Vector2(800,600)):
	node.prepare(reference,viewport)
	node.arrange(node.measure())
func _initialize():
	for axis in [0,1]:
		var main: String = "width" if axis==0 else "height"
		var p=model({"width":300,"height":300,"column_gap":20,"row_gap":20},axis)
		var a=model({main:"25%"})
		var b=model({main:"75%"})
		p.set_children([a,b]);layout(p)
		check(near(a.size[axis],70) and near(b.size[axis],210) and near(b.offset[axis],90),"nonwrap 25/75 shared280 budget axis"+str(axis))
		check(near(b.offset[axis]+b.size[axis],300),"last edge exactly300 axis"+str(axis))
		p.set_strategy("wrap");layout(p)
		check(near(a.size[axis],75) and near(b.size[axis],225) and near(b.offset[axis],0),"Wrap full300 basis creates second line axis"+str(axis))
		p.set_strategy("stack");p.set_children([b]);b.set_lengths({main:Length.parse("100%","extent")},0,0,1,0);layout(p)
		check(near(b.size[axis],300),"one child no phantom gap axis"+str(axis))
		p.set_children([]);layout(p)
		check(p.slots.is_empty(),"zero children axis"+str(axis))
	var p=model({"width":300,"height":100,"column_gap":20,"row_gap":90})
	var a=model({"width":"25%","height":"100%","padding_left":"10%","border_left_width":"5%","margin_left":"2%","x":"3%","min_width":"1%","max_width":"200%"})
	var b=model({"width":"75%"})
	p.set_children([a,b]);layout(p)
	check(near(a.size.x,70) and near(a.size.y,100) and near(a.dimension_reference.x,280),"X gaps affect dimensions on X only")
	check(near(a.parent_reference.x,300) and near(a.padding.x,30) and near(a.border.x,15) and near(a.margin.x,6) and near(a.length_offset.x,9) and near(a.authored_minimum.x,3) and near(a.authored_maximum.x,600),"padding border margin offset min/max keep ordinary300 reference")
	var fixed=model({"width":100})
	p.set_children([fixed,b]);layout(p)
	check(near(b.size.x,210) and near(b.offset.x+b.size.x,330),"fixed100 plus75% intentionally overflows330")
	p.set_lengths({"width":Length.parse(300,"extent"),"column_gap":Length.parse("2.5vw","edge")},0,0,1,0);layout(p)
	check(near(p.physical_gaps.x,20) and near(b.size.x,210),"viewport gap resolved once before dimension budget")
	p.set_lengths({"width":Length.parse(300,"extent"),"column_gap":Length.parse("10%","edge")},0,0,1,0);layout(p,Vector3(600,100,0))
	check(near(p.physical_gaps.x,60) and near(b.size.x,180),"percentage gap keeps its own containing600 reference")
	p.set_lengths({"width":Length.parse(300,"extent"),"column_gap":Length.parse(12.5,"edge")},0,0,1,0);layout(p)
	check(near(b.size.x,215.625),"fractional gap exact arithmetic")
	var third=model({"width":0})
	p.set_children([fixed,b,third]);layout(p)
	check(near(b.size.x,206.25),"later insertion updates earlier dimension budget")
	p.set_children([b,third,fixed]);layout(p)
	check(near(b.offset.x,0) and near(b.size.x,206.25),"reorder retains common budget")
	var padded=model({"width":400,"padding":20,"border_width":5,"column_gap":20})
	padded.set_strategy("wrap")
	var ratio=model({"width":"75%","border_width":3})
	padded.set_children([ratio]);layout(padded)
	check(near(ratio.size.x,262.5) and near(ratio.offset.x,25),"inside border/padding once, Wrap75% of350")
	var grid=model({"width":300,"height":200,"column_gap":20,"row_gap":10})
	grid.set_strategy("grid","start",{"columns":2,"areas":["header header","side body"]})
	grid.set_policy(["stretch","stretch","start"])
	var header=model({},0,Vector3(100,30,0));header.set_placement({"area":"header"})
	var side=model({"width":"25%"});side.set_placement({"area":"side"})
	var body=model({"width":"75%","padding":20,"border_width":5});body.set_placement({"area":"body"})
	var inner=model({"width":"100%","column_gap":20});inner.set_strategy("wrap")
	var leaf=model({"width":"75%","height":10});inner.set_children([leaf]);body.set_children([inner])
	grid.set_children([header,side,body]);layout(grid)
	check(grid.policy_result.columns==[70.0,210.0] and near(side.size.x,70) and near(body.size.x,210),"existing Grid floors water-fill70/210")
	check(near(header.size.x,300) and near(body.offset.x,90),"spanning auto Header fills whole cell with internal gap")
	check(near(inner.size.x,160) and near(leaf.size.x,120),"Grid Body actual210 gives nested content160 and Wrap child120")
	var proxy=Core.new();proxy.transparent=true
	grid.set_children([]);proxy.set_children([body]);grid.set_children([header,side,proxy]);proxy.set_placement({"area":"body"});layout(grid)
	check(near(proxy.size.x,210) and near(body.size.x,210) and near(inner.size.x,160),"transparent host forwards both contexts exactly once")
	grid.set_strategy("grid","start",{"columns":["50px","1fr"],"areas":["header header","side body"]});layout(grid)
	check(near(grid.policy_result.columns[0],50) and near(side.size.x,70),"explicit fixed track is not normalized to fit percent child")
	var legacy=model({"width":300,"column_gap":20});legacy.dimension_budget_enabled=false
	var old=model({"width":"75%"});legacy.set_children([model({"width":100}),old]);layout(legacy)
	check(near(old.size.x,225),"3D coordinator opt-out preserves prior dimensions")
	var v=model({"row_gap":20},1);v.set_children([model({"height":10}),model({"height":10})]);layout(v)
	check(near(v.measured.y,40) and near(v.children[1].offset.y,30),"row_gap override consistent natural and slots")
	var auto_grid=model({"width":300,"height":300,"column_gap":20,"row_gap":10})
	auto_grid.set_strategy("grid","start",{"columns":2,"areas":["head head","side body"]});auto_grid.set_policy(["stretch","stretch","start"])
	var auto_header=model({},0,Vector3(0,30,0));auto_header.set_placement({"area":"head"})
	var auto_side=model({"width":"25%"});auto_side.set_placement({"area":"side"})
	var auto_body=model({"padding":20,"border_width":5});auto_body.set_placement({"area":"body"})
	var auto_wrap=model({"width":"100%","gap":20});auto_wrap.set_strategy("wrap")
	auto_wrap.set_children([model({"width":70,"height":20}),model({"width":70,"height":20})]);auto_body.set_children([auto_wrap]);auto_grid.set_children([auto_header,auto_side,auto_body]);layout(auto_grid)
	check(near(auto_body.size.x,140) and near(auto_wrap.size.x,90) and near(auto_wrap.size.y,60) and near(auto_body.size.y,110),"allocated ordinary auto Body remeasures wrapped cross height before Grid rows")
	var growth=model({"width":300,"height":100})
	var ga=model();ga.grow=1;var gb=model();gb.grow=1
	ga.set_children([model({"width":"75%","height":10})]);gb.set_children([model({"width":"25%","height":10})]);growth.set_children([ga,gb]);layout(growth)
	check(near(ga.size.x,150) and near(gb.size.x,150) and near(ga.children[0].size.x,112.5) and near(gb.children[0].size.x,37.5),"allocated descendant ratios do not become a second grow basis")
	ga.children[0].invalidate();layout(growth)
	check(near(ga.size.x,150) and near(gb.size.x,150),"genuine descendant invalidation preserves growth basis")
	var compressed=model({"width":10,"gap":20});var ca=model({"width":"25%"});var cb=model({"width":"75%"});compressed.set_children([ca,cb]);layout(compressed)
	check(near(ca.size.x,0) and near(cb.size.x,0) and near(cb.offset.x,20),"compressed positive budget clamps to zero without shrinking the gap")
	var limited=model({"width":400,"max_width":300,"column_gap":20});var la=model({"width":"25%","min_width":100});var lb=model({"width":"75%"});limited.set_children([la,lb]);layout(limited)
	check(near(limited.size.x,300) and near(la.size.x,100) and near(lb.size.x,210) and near(lb.offset.x+lb.size.x,330),"actual constrained parent and child floor preserve forward overflow")
	var over=model({"width":300,"column_gap":20});var oa=model({"width":"150%"});var ob=model({"width":"25%"});over.set_children([oa,ob]);layout(over)
	check(near(oa.size.x,420) and near(ob.size.x,70),"over100 percent targets stay live unnormalized ratios")
	var track_grid=model({"width":300,"column_gap":20});track_grid.set_strategy("grid","start",{"columns":["25%","75%"]});track_grid.set_policy(["stretch","stretch","start"]);track_grid.set_children([model(),model()]);layout(track_grid)
	check(track_grid.policy_result.columns==[75.0,225.0] and near(track_grid.children[1].offset.x+track_grid.children[1].size.x,320),"Grid track percentages retain full content grammar and honest overflow")
	v.configure(v.requested,v.gap,false,1,Vector3.ZERO,Vector3(1,1,0));layout(v)
	check(near(v.size.y,40) and near(v.children[1].offset.y,30),"intrinsic refresh preserves physical row_gap override")
	var budgets=p.dimension_budget_count;p.invalidate();layout(p)
	check(p.dimension_budget_count==budgets,"same parent context reuses one cached dimension budget")
	var idle=[grid.measure_count,grid.arrange_count,body.resolution_count,inner.resolution_count]
	layout(grid)
	check(idle==[grid.measure_count,grid.arrange_count,body.resolution_count,inner.resolution_count],"settled pure core does no repeat measure/arrange/resolve")
	print("L12_PERCENT_ASSERTIONS ",checks," failed=",failed)
	if not failed: print("L12_PERCENT_OK")
	quit(1 if failed else 0)
