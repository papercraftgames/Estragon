n":92,"line":18,"offset":974},"start":{"column":13,"line":18,"offset":895}}},{"generated":{"end":{"column":1,"line":96,"offset":4057},"start":{"column":1,"line":95,"offset":3895}},"kind":"generated","original":{"end":{"column":49,"line":19,"offset":1023},"start":{"column":13,"line":19,"offset":987}}},{"generated":{"end":{"column":1,"line":97,"offset":4266},"start":{"column":1,"line":96,"offset":4057}},"kind":"generated","original":{"end":{"column":107,"line":20,"offset":1130},"start":{"column":13,"line":20,"offset":1036}}},{"generated":{"end":{"column":1,"line":98,"offset":4455},"start":{"column":1,"line":97,"offset":4266}},"kind":"generated","original":{"end":{"column":69,"line":21,"offset":1199},"start":{"column":13,"line":21,"offset":1143}}},{"generated":{"end":{"column":1,"line":99,"offset":4672},"start":{"column":1,"line":98,"offset":4455}},"kind":"generated","original":{"end":{"column":93,"line":22,"offset":1292},"start":{"column":13,"line":22,"offset":1212}}},{"generated":{"end":{"column":1,"line":100,"offset":4932},"start":{"column":1,"line":99,"offset":4672}},"kind":"generated","original":{"end":{"column":16,"line":23,"offset":1308},"start":{"column":9,"line":17,"offset":839}}},{"generated":{"end":{"column":1,"line":101,"offset":5128},"start":{"column":1,"line":100,"offset":4932}},"kind":"generated","original":{"end":{"column":13,"line":24,"offset":1321},"start":{"column":12,"line":16,"offset":774}}},{"generated":{"end":{"column":1,"line":102,"offset":5159},"start":{"column":1,"line":101,"offset":5128}},"kind":"generated","original":{"end":{"column":13,"line":24,"offset":1321},"start":{"column":12,"line":16,"offset":774}}}],"sourceContent":"extends Node2D\nconst Element = preload(\"../../../addons/estragon/runtime/composition/element.gd\")\nconst Entry = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Rect = preload(\"../../../addons/estragon/runtime/node/rect.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nconst Model = preload(\"res://examples/composition/generated/Model.gd\")\n@bindable var count: int = 0\n@bindable var unused: int = 0\n@bindable var model: Model = Model.new()\nfunc heading(title: String) -> String:\n    return title\nfunc build_view() -> Element:\n    var caption: String = \"Count: %d\" % count\n    return <Entry name=\"UI\" position={Vector2(24,24)} width=\"90vw\">\n        <VBox name=\"Panel\" width=\"100%\" gap={12.0}>\n            <Text name=\"Title\" text={heading(model.title)} color={Color(0.74,0.64,0.94)} />\n            <Text name=\"Count\" text={caption} />\n            <Rect name=\"Bar\" width={model.width + count * 10.0} height={10.0} fill={Color(0.2,0.8,0.6)} />\n            <Button name=\"Increment\" text=\"+\" pressed={increment} />\n            <Button name=\"Reset\" text=\"Reset\" disabled={count == 0} pressed={reset_count} />\n        </VBox>\n    </Entry>\nfunc increment() -> void:\n    count += 1\nfunc reset_count() -> void:\n    count = 0\nfunc _ready() -> void:\n    if OS.get_environment(\"ESTRAGON_COMPOSITION_PROOF\") == \"1\": write_proof.call_deferred()\nfunc write_proof() -> void:\n    for index in range(5): await get_tree().process_frame\n    var file := FileAccess.open(\"res://.godot/composition-play.json\",FileAccess.WRITE)\n    file.store_string(JSON.stringify({\"count\":count,\"text\":get_node(\"UI/Panel/Count\").text}))\n","sourceName":"examples/composition/Counter.gogo","version":1}
