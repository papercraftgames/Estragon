erated","original":{"end":{"column":56,"line":22,"offset":1398},"start":{"column":14,"line":22,"offset":1356}}},{"generated":{"end":{"column":1,"line":128,"offset":7660},"start":{"column":1,"line":127,"offset":7567}},"kind":"generated","original":{"end":{"column":38,"line":22,"offset":1380},"start":{"column":35,"line":22,"offset":1377}}},{"generated":{"end":{"column":1,"line":129,"offset":7756},"start":{"column":1,"line":128,"offset":7660}},"kind":"generated","original":{"end":{"column":49,"line":22,"offset":1391},"start":{"column":43,"line":22,"offset":1385}}},{"generated":{"end":{"column":1,"line":130,"offset":7799},"start":{"column":1,"line":129,"offset":7756}},"kind":"generated","original":{"end":{"column":56,"line":22,"offset":1398},"start":{"column":14,"line":22,"offset":1356}}},{"generated":{"end":{"column":1,"line":131,"offset":7830},"start":{"column":1,"line":130,"offset":7799}},"kind":"generated","original":{"end":{"column":56,"line":22,"offset":1398},"start":{"column":14,"line":22,"offset":1356}}}],"sourceContent":"extends Node2D\nconst Item = preload(\"Item.gd\")\nconst Header = preload(\"Header.gd\")\nconst Row = preload(\"Row.gd\")\nconst Element = preload(\"../../../addons/estragon/runtime/composition/element.gd\")\nconst Entry = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst Grid = preload(\"../../../addons/estragon/runtime/node/grid.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst Rect = preload(\"../../../addons/estragon/runtime/node/rect.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Input = preload(\"../../../addons/estragon/runtime/node/input.gd\")\n@bindable var items: ArrayCollection[Item] = [{\"id\":1,\"label\":\"One\"},{\"id\":2,\"label\":\"Two\"},{\"id\":3,\"label\":\"Three\"},{\"id\":4,\"label\":\"Four\"},{\"id\":5,\"label\":\"Five\"},{\"id\":6,\"label\":\"Six\"},{\"id\":7,\"label\":\"Seven\"},{\"id\":8,\"label\":\"Eight\"},{\"id\":9,\"label\":\"Nine\"},{\"id\":10,\"label\":\"Ten\"}]\n@bindable var caption: String = \"Edit me\"\n@bindable var show_header: bool = true\nvar calls: int = 0\nfunc row(value: Item) -> Element:\n    return <Row key={value.id} name={\"Row\"+str(value.id)} item={value} />\nfunc build_view() -> Element:\n    calls += 1\n    return <Entry name=\"UI\" width=\"100%\" height=\"100%\">\n        <Grid name=\"Grid\" width=\"100%\" height=\"100%\" columns={2} rows={[\"auto\",\"1fr\"]} column_gap=\"20px\" row_gap=\"12px\">\n            {<Header name=\"Title\" row={0} column={0} /> if self.show_header else null}\n            <Rect name=\"Fixed\" row={0} column={1} width=\"10px\" height=\"10px\" background_color=\"#dd9966\" />\n            <VBox name=\"Body\" row={1} column={0} column_span={2} vertical_scroll padding=\"20px\" border_width=\"2px\" border_color=\"#88aacc\" background_color=\"#202a34\" gap=\"6px\">\n                <Input name=\"Editor\" width=\"140px\" value={self.caption} />\n                {items.map(row)}\n            </VBox>\n        </Grid>\n    </Entry>\n","sourceName":"examples/constraint_layout/Constraints.gogo","version":1}
