\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst HBox = preload(\"../../../addons/estragon/runtime/node/hbox.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nconst Toggle = preload(\"../../../addons/estragon/runtime/node/toggle.gd\")\nconst NativeButton = preload(\"../../godot_button.gd\")\nconst NativeOnly = preload(\"NativeOnly.gd\")\nconst TypedButton = preload(\"TypedButton.gd\")\nconst PANEL_TEXTURE = preload(\"../../surfaces/panel_gradient.tres\")\nconst AnotherButton = Button\n@bindable var checked: bool = false\n@bindable var props: Dictionary = {}\n@bindable var selected: Button = null\nvar clicks: int = 0\nvar native_clicks: int = 0\nfunc pressed(): clicks += 1\nfunc native_pressed(): native_clicks += 1\nfunc typed(value: Button) -> Button: return value\nfunc constructors() -> Array:\n\treturn [Button.new(),AnotherButton.new(),NativeButton.new(),ClassDB.instantiate(\"Button\")]\nfunc member_and_string() -> String:\n\tvar object := {\"Button\":\"Button member\"}\n\treturn object.Button # Button is data here, not the imported identifier.\nfunc build_view() -> Element:\n\treturn <Entry2D name=\"UI\" width=\"100%\" height=\"100%\" padding=\"12px\" background_color=\"#171b24\" vertical_scroll>\n\t\t<VBox name=\"Column\" width=\"100%\" gap=\"8px\">\n\t\t\t<Text>Import-selected Button</Text>\n\t\t\t<HBox name=\"Kinds\" wrap gap=\"8px\">\n\t\t\t\t<Button name=\"Action\" text=\"Estragon Button\" width=\"180px\" height=\"56px\" pressed={pressed} {...self.props} />\n\t\t\t\t<NativeButton name=\"Native\" text=\"Native script alias\" pressed={native_pressed} />\n\t\t\t\t<NativeOnly name=\"Unimported\" />\n\t\t\t</HBox>\n\t\t\t<Button name=\"Disabled\" disabled width=\"180px\" height=\"56px\">Disabled charcoal</Button>\n\t\t\t<Toggle name=\"Toggle\" width=\"180px\" height=\"56px\" value={self.checked}>Teal when checked</Toggle>\n\t\t\t<Button name=\"Surface\" width=\"240px\" height=\"72px\" corner_radius=\"18px\" background_color=\"#283842\" background_texture={PANEL_TEXTURE} pressed={pressed}>Explicit native surface</Button>\n\t\t\t<TypedButton name=\"Typed\" supplied={self.selected} />\n\t\t</VBox>\n\t</Entry2D>\n","sourceName":"examples/button_imports/Buttons.gogo","version":1}
