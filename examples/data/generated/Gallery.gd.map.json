me/node/estragon_2d.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst HBox = preload(\"../../../addons/estragon/runtime/node/hbox.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nvar inventory: Inventory = {\"items\":[{\"id\":1,\"name\":\"Rope\",\"details\":{\"note\":\"Coiled\"}},{\"id\":2,\"name\":\"Lantern\",\"quantity\":2}]}\nvar row_calls: Dictionary = {}\nvar summary_calls: int = 0\nvar summarize: Callable = summary.bind()\nvar root_calls: int = 0\n@bindable var show_rows: bool = true\n@bindable var pulse: int = 0\n@bindable var raw: Array = []\n@bindable var raw_data: Dictionary = {\"value\":0}\nfunc summary(value: Inventory) -> String:\n    summary_calls += 1\n    return value.title + \": \" + str(value.items.size()) + \" items; \" + (value.items.at(0).details.note if not value.items.is_empty() else \"empty\")\nfunc row(item: Item) -> Element:\n    row_calls[item.id] = row_calls.get(item.id,0)+1\n    return <HBox key={item.id} name={\"Row\"+str(item.id)} width=\"100%\" height=\"48px\"><Text text={item.name+\" × \"+str(item.quantity)+\" — \"+item.details.note} /><Button name=\"Action\" text=\"Use\" pressed={self.use_item.bind(item)} /></HBox>\nfunc use_item(item: Item) -> void:\n    item.quantity = item.quantity+1\nfunc build_view() -> Element:\n    root_calls += 1\n    return <Entry name=\"DataUI\" width=\"640px\" height=\"360px\"><VBox name=\"List\" width=\"100%\" height=\"100%\" gap=\"8px\" padding=\"16px\"><Text name=\"Title\" text={summarize.call(inventory)} />{inventory.items.map(row) if self.show_rows else []}<Text name=\"Pulse\" text={str(self.pulse)+\" / raw \"+str(self.raw.size())+\":\"+str(self.raw_data.value)} /></VBox></Entry>\nfunc replace_inventory() -> void:\n    inventory = {\"title\":\"Refilled\",\"items\":[{\"id\":2,\"name\":\"Lantern\",\"quantity\":3},{\"id\":1,\"name\":\"Rope\"}]}\nfunc replace_items() -> void:\n    inventory.items = [{\"id\":1,\"name\":\"Cable\"}]\n","sourceName":"examples/data/Gallery.gogo","version":1}
