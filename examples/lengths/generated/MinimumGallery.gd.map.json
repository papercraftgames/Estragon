\" width=\"100%\" padding=\"12px\" border_width=\"2px\" border_color=\"#8295bc\" background_color=\"#252b38\" gap=\"12px\">\n        <Text name=\"Caption\" text=\"A readable minimum\" min_width=\"120px\" color={Color(\"#ffcc66\")} />\n        <UiButton name=\"Continue\" text=\"Continue\" width=\"50%\" height=\"20px\" min_width=\"96px\" min_height=\"36px\" padding=\"6px\" font_size={18} background_color=\"#355e92\" border_color=\"#cbd8ed\" border_width=\"1px\" pressed={self.pressed} />\n        <Toggle name=\"Enabled\" text=\"Enabled\" min_width=\"120px\" min_height=\"36px\" bind:value={self.enabled} />\n        <Button name=\"Native\" text=\"Native Button\" pressed={self.native_pressed} />\n        <Nested name=\"Nested\" />\n    </VBox>\n    if self.constrained:\n        panel.properties[\"min_width\"] = self.floor_width\n        panel.properties[\"min_height\"] = \"200px\"\n    return <Entry2D name=\"UI\" width=\"100%\" height=\"100%\" padding=\"12px\" background_color=\"#171b24\">{panel}</Entry2D>\n","sourceName":"examples/lengths/MinimumGallery.gogo","version":1}
