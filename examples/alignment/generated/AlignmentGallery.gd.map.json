2,"offset":2654},"start":{"column":9,"line":24,"offset":1374}}},{"generated":{"end":{"column":28,"line":134,"offset":9006},"start":{"column":1,"line":132,"offset":8977}},"kind":"generated","original":{"end":{"column":82,"line":39,"offset":2582},"start":{"column":5,"line":39,"offset":2505}}},{"generated":{"end":{"column":1,"line":135,"offset":9027},"start":{"column":28,"line":134,"offset":9006}},"kind":"generated","original":{"end":{"column":82,"line":39,"offset":2582},"start":{"column":5,"line":39,"offset":2505}}},{"generated":{"end":{"column":1,"line":136,"offset":9216},"start":{"column":1,"line":135,"offset":9027}},"kind":"generated","original":{"end":{"column":82,"line":39,"offset":2582},"start":{"column":5,"line":39,"offset":2505}}},{"generated":{"end":{"column":1,"line":137,"offset":9241},"start":{"column":1,"line":136,"offset":9216}},"kind":"generated","original":{"end":{"column":82,"line":39,"offset":2582},"start":{"column":5,"line":39,"offset":2505}}}],"sourceContent":"extends Node2D\nconst Element = preload(\"../../../addons/estragon/runtime/composition/element.gd\")\nconst Entry2D = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst Box = preload(\"../../../addons/estragon/runtime/node/box.gd\")\nconst HBox = preload(\"../../../addons/estragon/runtime/node/hbox.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Rect = preload(\"../../../addons/estragon/runtime/node/rect.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nconst NativeButton = preload(\"../../godot_button.gd\")\nconst Toggle = preload(\"../../../addons/estragon/runtime/node/toggle.gd\")\n@bindable var policy: Dictionary = {\"direction\":\"row\", \"horizontal_align\":\"space-between\", \"vertical_align\":\"center\"}\n@bindable var child_props: Dictionary = {\"align_self\":\"end\"}\n@bindable var order: Array = [\"a\",\"b\",\"c\"]\n@bindable var show_extra: bool = true\n@bindable var enabled: bool = false\nvar clicks: int = 0\nvar native_clicks: int = 0\nfunc pressed() -> void: clicks += 1\nfunc native_pressed() -> void: native_clicks += 1\nfunc tile(value: String) -> Element:\n\treturn <Rect key={value} name={value} width=\"40px\" height=\"30px\" background_color=\"#477dbb\" {...(self.child_props if value==\"b\" else {})} />\nfunc build_view() -> Element:\n\treturn <Entry2D name=\"UI\" width=\"100%\" height=\"100%\" padding=\"12px\" background_color=\"#171b24\">\n\t\t<VBox name=\"Content\" width=\"100%\" height=\"100%\" horizontal_align=\"stretch\" gap=\"12px\">\n\t\t\t<HBox name=\"Header\" width=\"100%\" height=\"64px\" horizontal_align=\"space-between\" vertical_align=\"center\" padding=\"12px\" background_color=\"#252b38\" border_width=\"2px\" border_color=\"#8295bc\">\n\t\t\t\t<Text text=\"Inventory\" color={Color(\"#ffc65c\")} />\n\t\t\t\t<Button name=\"Close\" text=\"Close\" height=\"32px\" min_width=\"96px\" pressed={pressed} />\n\t\t\t</HBox>\n\t\t\t<HBox name=\"Even\" width=\"100%\" height=\"96px\" horizontal_align=\"space-evenly\" vertical_align=\"center\" background_color=\"#252b38\">\n\t\t\t\t{self.order.map(tile)}\n\t\t\t</HBox>\n\t\t\t<Box name=\"Configurable\" width=\"100%\" height=\"110px\" gap=\"10px\" padding=\"8px\" {...self.policy} background_color=\"#30394d\">\n\t\t\t\t<Button name=\"Action\" text=\"Aligned action\" min_height=\"36px\" pressed={pressed} />\n\t\t\t\t<Toggle name=\"Enabled\" text=\"Enabled\" min_height=\"36px\" bind:value={self.enabled} />\n\t\t\t\t<NativeButton name=\"Native\" text=\"Native Control\" pressed={native_pressed} />\n\t\t\t</Box>\n\t\t\t<NestedAlignment name=\"Nested\" />\n\t\t\t{<Text key=\"extra\" name=\"Extra\" text=\"Physical axes, retained native nodes\" /> if self.show_extra else null}\n\t\t\t{get_children()}\n\t\t</VBox>\n\t</Entry2D>\n","sourceName":"examples/alignment/AlignmentGallery.gogo","version":1}
