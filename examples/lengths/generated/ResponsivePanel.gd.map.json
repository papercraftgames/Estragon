":12,"line":15,"offset":930},"start":{"column":12,"line":11,"offset":554}}}],"sourceContent":"extends Node2D\nconst Element = preload(\"../../../addons/estragon/runtime/composition/element.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst Rect = preload(\"../../../addons/estragon/runtime/node/rect.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\n@bindable var width_percent: float = 50.0\nfunc toggle_width() -> void:\n    width_percent = 25.0 if width_percent == 50.0 else 50.0\nfunc build_view() -> Element:\n    return <VBox name=\"Panel\" width={\"%s%%\" % self.width_percent} height=\"75%\" padding={10} gap={8}>\n        <Text text={\"%s%% width / 75%% height\" % self.width_percent} font_size={18} />\n        <Rect name=\"Color\" grow={1} stretch={1} fill={Color(0.25,0.5,0.9)} />\n        <Button name=\"Action\" text=\"Toggle 25% / 50%\" height={40} width=\"100%\" pressed={self.toggle_width} />\n    </VBox>\n","sourceName":"examples/lengths/ResponsivePanel.gogo","version":1}
