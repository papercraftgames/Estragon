 Entry = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst HBox = preload(\"../../../addons/estragon/runtime/node/hbox.gd\")\nconst Rect = preload(\"../../../addons/estragon/runtime/node/rect.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst UiButton = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nconst State = preload(\"res://examples/reactive/generated/State.gd\")\nconst Model = preload(\"res://examples/reactive/generated/Model.gd\")\n@bindable var model: Model = Model.new()\n@bindable var count: int = 0\nvar ui: Node:\n    get: return get_node_or_null(\"UI\")\nfunc independent() -> String:\n    return \"Pure helper in the same observed view\"\nfunc _ready() -> void:\n    if OS.get_environment(\"ESTRAGON_REACTIVE_PROOF\") == \"1\": write_proof.call_deferred()\nfunc build_view() -> Element:\n    var player: State = model.player if model != null else null\n    return <Entry name=\"UI\" position={Vector2(24,24)} viewport_width_scale={0.9}>\n        <VBox name=\"Panel\" fill_width={true} gap={12.0 + self.count}>\n            {<Text name=\"Title\" text={player.title} color={player.tint} /> if player != null else <Text name=\"Title\" />}\n            <HBox name=\"Row\" fill_width={true} gap={12.0}>\n                {<Rect name=\"Bar\" width={player.width} height={40.0} fill={player.tint} /> if player != null else <Rect name=\"Bar\" height={40.0} />}\n                <Rect name=\"Other\" width={80.0} height={40.0} fill={Color(0.55,0.32,0.9)} />\n            </HBox>\n            <Text name=\"Count\" text={\"Value: %d\" % (self.count + self.count)} />\n            <UiButton name=\"Advance\" text=\"Change model and layout\" pressed={advance} />\n            <Text name=\"Independent\" text={independent()} />\n        </VBox>\n    </Entry>\nfunc advance() -> void:\n    count += 1\n    model.player.width += 40.0\n    model.player.tint = Color(0.9,0.35,0.2)\n    model.player.title = \"Changed without rebuilding\"\nfunc write_proof() -> void:\n    await get_tree().process_frame\n    await get_tree().process_frame\n    var file := FileAccess.open(\"res://.godot/reactive-play.json\",FileAccess.WRITE)\n    file.store_string(JSON.stringify({\"count\":count,\"text\":ui.get_node(\"Panel/Count\").text}))\n","sourceName":"examples/reactive/Demo.gogo","version":1}
