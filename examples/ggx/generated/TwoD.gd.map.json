preload(\"res://addons/estragon/runtime/node/native_2d.gd\")\nconst Custom = preload(\"res://examples/ggx/probe_2d.gd\")\n\nfunc compose() -> Node:\n    dimension = 2\n    return <Entry name=\"Entry\" position={Vector2(value(\"root\",50),100)} gap={value(\"gap\",30)}>\n        <Native name=\"First\" width={value(\"first\",120)} height={70.0}>\n            <Polygon2D name=\"Visual\" polygon={PackedVector2Array([Vector2.ZERO,Vector2(100,0),Vector2(100,60),Vector2(0,60)])} color={Color(0.2,0.8,0.6)} />\n        </Native>\n        <Native name=\"Second\">\n            <Polygon2D name=\"Visual\" polygon={PackedVector2Array([Vector2.ZERO,Vector2(90,0),Vector2(90,60),Vector2(0,60)])} color={Color(0.55,0.35,0.9)} />\n        </Native>\n        <Timer name=\"Pulse\" one_shot={true} timeout={on_timeout} />\n        <Custom name=\"Custom\" amount={value(\"custom\",7)} palette={palette} position={Vector2(10,150)}>\n            <Node2D name=\"Nested\" position={Vector2(3,4)} />\n        </Custom>\n    </Entry>\n\nfunc _enter_tree() -> void:\n    palette.changed.connect(on_palette_changed)\n\nfunc _exit_tree() -> void:\n    if palette.changed.is_connected(on_palette_changed): palette.changed.disconnect(on_palette_changed)\n\n","sourceName":"examples/ggx/TwoD.gogo","version":1}
