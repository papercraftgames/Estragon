me/node/rect.gd\")\nconst Button = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nconst Model = preload(\"res://examples/composition/generated/Model.gd\")\n@bindable var count: int = 0\n@bindable var unused: int = 0\n@bindable var model: Model = Model.new()\nfunc heading() -> String:\n    return model.title\nfunc build_view() -> Element:\n    var caption: String = \"Count: %d\" % count\n    return <Entry name=\"UI\" position={Vector2(24,24)} width=\"90vw\">\n        <VBox name=\"Panel\" width=\"100%\" gap={12.0}>\n            <Text name=\"Title\" text={heading()} color={Color(0.74,0.64,0.94)} />\n            <Text name=\"Count\" text={caption} />\n            <Rect name=\"Bar\" width={model.width + count * 10.0} height={10.0} fill={Color(0.2,0.8,0.6)} />\n            <Button name=\"Increment\" text=\"+\" pressed={increment} />\n            <Button name=\"Reset\" text=\"Reset\" disabled={count == 0} pressed={reset_count} />\n        </VBox>\n    </Entry>\nfunc increment() -> void:\n    count += 1\nfunc reset_count() -> void:\n    count = 0\nfunc _ready() -> void:\n    if OS.get_environment(\"ESTRAGON_COMPOSITION_PROOF\") == \"1\": write_proof.call_deferred()\nfunc write_proof() -> void:\n    for index in range(5): await get_tree().process_frame\n    var file := FileAccess.open(\"res://.godot/composition-play.json\",FileAccess.WRITE)\n    file.store_string(JSON.stringify({\"count\":count,\"text\":get_node(\"UI/Panel/Count\").text}))\n","sourceName":"examples/composition/Counter.gogo","version":1}
