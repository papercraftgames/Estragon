ange_padding() -> void:\n    inset = 24.0 if inset == 12.0 else 12.0\nfunc build_view() -> Element:\n    return <Entry name=\"UI\" position={Vector2(24,24)} width={440} padding={8}>\n        <VBox name=\"Panel\" padding={self.inset} padding_left={24} gap={12} width=\"100%\">\n            <Text text=\"Pixel padding and margins\" font_size={24} />\n            <HBox padding={8} gap={10} margin_left={12}>\n                <Rect width={80} height={40} fill={Color(0.9,0.3,0.3)} margin_right={6} />\n                <Rect width={80} height={40} fill={Color(0.3,0.6,1.0)} margin_top={8} />\n            </HBox>\n            <UiButton name=\"Action\" text=\"Change padding\" height={44} width=\"100%\" margin={4} pressed={change_padding} />\n        </VBox>\n    </Entry>\n","sourceName":"examples/box_model/BoxModel.gogo","version":1}
