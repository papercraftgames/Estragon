ne":15,"offset":655}}}],"sourceContent":"extends Node2D\nconst Element = preload(\"../../../addons/estragon/runtime/composition/element.gd\")\nconst Entry2D = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst VBox = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst HBox = preload(\"../../../addons/estragon/runtime/node/hbox.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nvar picture: Texture2D\nfunc _ready() -> void:\n\tvar image := Image.create(64,24,false,Image.FORMAT_RGBA8)\n\timage.fill(Color.CORNFLOWER_BLUE)\n\tpicture = ImageTexture.create_from_image(image)\nfunc exit() -> void:\n\tget_tree().quit()\nfunc build_view() -> Element:\n\treturn <Entry2D position={Vector2(24,24)} width={520.0}>\n\t\t<VBox gap={8.0} width=\"100%\">\n\t\t\t<HBox gap={8.0}><Button text=\"Exit\" pressed={self.exit} /><Label text=\"Ready\" /></HBox>\n\t\t\t<VBox gap={8.0}><LineEdit placeholder_text=\"Native editing\" /><TextureRect texture={self.picture} /></VBox>\n\t\t\t<HBoxContainer><Label text=\"Godot owns \" /><Label text=\"Container internals\" /></HBoxContainer>\n\t\t\t<Text text=\"The next Button is borrowed from the Scene dock:\" />\n\t\t\t{get_children()}\n\t\t\t<NativeSettings />\n\t\t</VBox>\n\t</Entry2D>\n","sourceName":"examples/nested_layout/NativeGallery.gogo","version":1}
