../addons/estragon/runtime/composition/element.gd\")\nconst Entry = preload(\"../../../addons/estragon/runtime/node/estragon_2d.gd\")\nconst Box = preload(\"../../../addons/estragon/runtime/node/vbox.gd\")\nconst Toggle = preload(\"../../../addons/estragon/runtime/node/toggle.gd\")\nconst Text = preload(\"../../../addons/estragon/runtime/node/text.gd\")\nconst Action = preload(\"../../../addons/estragon/runtime/node/button.gd\")\nconst Row = preload(\"res://examples/twoway/generated/Row.gd\")\nvar model: Model = Model.new()\nvar enabled: bool = false\nvar show_row: bool = true\nvar reverse: bool = false\nvar revision: int = 0\nfunc build_view() -> Element:\n    var rows: Array = [<Row key={1} name=\"First\" model={self.model} />, <Row key={2} name=\"Second\" model={self.model} />] if self.model != null and self.show_row else []\n    if self.reverse: rows.reverse()\n    return <Entry name=\"UI\"><Box name=\"Panel\" gap={8.0}>\n        <Text name=\"Heading\" text=\"Native two-way boolean input\" />\n        {<Toggle name=\"Edit\" text=\"Model enabled\" bind:value={self.model.enabled} /> if self.model != null else null}\n        <Text name=\"Status\" text={\"Enabled\" if self.model != null and self.model.enabled else \"Disabled\"} />\n        <Toggle name=\"HostEdit\" text=\"Host flag\" bind:value={self.enabled} />\n        <Text name=\"Revision\" text={\"Revision: %d\" % self.revision} />\n        {rows}\n        <Action text=\"Replace model\" pressed={replace_model} />\n        <Action text=\"Show / hide rows\" pressed={toggle_rows} />\n        <Action name=\"Reverse\" text=\"Reverse keys\" pressed={reverse_rows} />\n    </Box></Entry>\nfunc replace_model() -> void:\n    model = Model.new()\nfunc toggle_rows() -> void:\n    show_row = not show_row\nfunc reverse_rows() -> void:\n    reverse = not reverse\nfunc _ready() -> void:\n    if OS.get_environment(\"ESTRAGON_TWOWAY_PROOF\")==\"1\": _proof.call_deferred()\nfunc _proof() -> void:\n    for index in range(8): await get_tree().process_frame\n    var output := FileAccess.open(\"res://.godot/twoway-play.json\",FileAccess.WRITE)\n    output.store_string(JSON.stringify({\"count\":revision,\"text\":\"Revision: %d\" % revision}))\n    output.close()\n","sourceName":"examples/twoway/Demo.gogo","version":1}
