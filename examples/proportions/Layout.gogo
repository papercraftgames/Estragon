extends Node2D
const Element = preload("../../../addons/estragon/runtime/composition/element.gd")
const Entry = preload("../../../addons/estragon/runtime/node/estragon_2d.gd")
const Grid = preload("../../../addons/estragon/runtime/node/grid.gd")
const Box = preload("../../../addons/estragon/runtime/node/box.gd")
const Text = preload("../../../addons/estragon/runtime/node/text.gd")
const Panel = preload("Panel.gd")
@export var borrowed: Node
@bindable var target: String = "75%"
@bindable var revision: int = 0
layout const <ProportionLayout columns={2} column_gap="20px" row_gap="12px">
    <Header /> <Header />
    <Side /> <Body />
</ProportionLayout>
func build_view() -> Element:
    return <Entry name="UI" width="100%" height="100%" padding="20px" direction="column" gap="12px" background_color="#172332">
        <Text text="L12 / parent-owned percentage budgets" />
        <ProportionLayout name="Grid" width="100%" height="280px">
            <Header><Text text="Auto header spans both tracks" /></Header>
            <Side name="Side" width="25%" background_color="#453747"><Text text="25%" /></Side>
            <Panel area="Body" name="Panel" width_target={self.target} revision={self.revision} />
        </ProportionLayout>
        <Box name="PlainRow" width="300px" column_gap="20px">
            <Box width="25%" height="40px" background_color="#5995b5" />
            <Box width="75%" height="40px" background_color="#70ab82" />
        </Box>
        {self.borrowed}
        <Text text="Row: 70 + gap20 + 210 = 300 / Wrap keeps 25% + 75% of full content" />
    </Entry>
