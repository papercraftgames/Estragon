\nconst Entry = preload(\"res://addons/estragon/runtime/node/estragon_2d.gd\")\nconst VBox = preload(\"res://addons/estragon/runtime/node/vbox.gd\")\nconst HBox = preload(\"res://addons/estragon/runtime/node/hbox.gd\")\nconst Rect = preload(\"res://addons/estragon/runtime/node/rect.gd\")\nconst Text = preload(\"res://addons/estragon/runtime/node/text.gd\")\nconst UiButton = preload(\"res://addons/estragon/runtime/node/button.gd\")\n@bindable var count: int = 0\nvar ui: Node:\n    get: return get_node_or_null(\"UI\")\n\nfunc _ready() -> void:\n    if OS.get_environment(\"ESTRAGON_C3_PROOF\") == \"1\": write_proof.call_deferred()\n\nfunc build_view() -> Element:\n    return <Entry name=\"UI\" position={Vector2(24,24)} viewport_width_scale={0.9}>\n        <VBox name=\"Panel\" fill_width={true} gap={16.0}>\n            <Rect name=\"Accent\" height={8.0} fill_width={true} fill={Color(0.2,0.8,0.6)} />\n            <Text name=\"Title\" text=\"Estragon native Gogo Counter\" font_size={28} color={Color(0.74,0.64,0.94)} />\n            <Text name=\"Count\" text={\"Count: %d\" % self.count} font_size={26} />\n            <HBox name=\"Actions\" fill_width={true} gap={12.0}>\n                <UiButton name=\"Increment\" text=\"+\" fill_width={true} pressed={increment} />\n                <UiButton name=\"Reset\" text=\"Reset\" fill_width={true} disabled={self.count == 0} pressed={reset_count} />\n            </HBox>\n            <VBox name=\"Details\" fill_width={true} gap={6.0}>\n                <Text name=\"Hint\" text=\"Click + to update retained Nodes.\" font_size={18} />\n                <Text name=\"Resize\" text=\"Resize the window: nested native stacks reflow.\" font_size={18} />\n            </VBox>\n        </VBox>\n    </Entry>\n\nfunc increment() -> void:\n    count += 1\n\nfunc reset_count() -> void:\n    count = 0\n\nfunc write_proof() -> void:\n    await get_tree().process_frame\n    await get_tree().process_frame\n    var file := FileAccess.open(\"res://.godot/c3-play.json\",FileAccess.WRITE)\n    file.store_string(JSON.stringify({\"count\":count,\"text\":ui.get_node(\"Panel/Count\").text,\"native\":ui.get_layout_root()==ui}))\n","sourceName":"examples/counter/Counter.gogo","version":1}
