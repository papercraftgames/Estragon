extends "res://examples/ggx/base.gd"
const Element = preload("../../../addons/estragon/runtime/composition/element.gd")
const Entry = preload("../../../addons/estragon/runtime/node/estragon_3d.gd")
const Native = preload("../../../addons/estragon/runtime/node/native_3d.gd")
const Custom = preload("res://examples/ggx/probe_3d.gd")

func build_view() -> Element:
    return <Entry name="Entry" position={Vector3(value("root",0),0,0)} gap={value("gap",0.5)}>
        <Native name="First" width={value("first",2.0)} height={1.2} depth={1.0}>
            <MeshInstance3D name="Visual" mesh={make_mesh()} />
        </Native>
        <Native name="Second">
            <MeshInstance3D name="Visual" mesh={make_mesh(Color(0.55,0.35,0.9))} />
        </Native>
        <Timer name="Pulse" one_shot={true} timeout={on_timeout} />
        <Node name="Boundary">
            <Custom name="Custom" amount={value("custom",7)} palette={palette} position={Vector3(10,20,30)}>
                <Node3D name="Nested" position={Vector3(1,2,3)} />
            </Custom>
        </Node>
    </Entry>

func _enter_tree() -> void:
    dimension = 3
    palette.changed.connect(on_palette_changed)

func _exit_tree() -> void:
    if palette.changed.is_connected(on_palette_changed): palette.changed.disconnect(on_palette_changed)

