"line":156,"offset":5565},"start":{"column":1,"line":155,"offset":5525}},"kind":"generated","original":{"end":{"column":14,"line":31,"offset":1468},"start":{"column":20,"line":17,"offset":451}}},{"generated":{"end":{"column":1,"line":157,"offset":5682},"start":{"column":1,"line":156,"offset":5565}},"kind":"generated","original":{"end":{"column":97,"line":22,"offset":977},"start":{"column":85,"line":22,"offset":965}}},{"generated":{"end":{"column":1,"line":158,"offset":5820},"start":{"column":1,"line":157,"offset":5682}},"kind":"generated","original":{"end":{"column":97,"line":22,"offset":977},"start":{"column":85,"line":22,"offset":965}}},{"generated":{"end":{"column":1,"line":159,"offset":5851},"start":{"column":1,"line":158,"offset":5820}},"kind":"generated","original":{"end":{"column":97,"line":22,"offset":977},"start":{"column":85,"line":22,"offset":965}}},{"generated":{"end":{"column":1,"line":160,"offset":5875},"start":{"column":1,"line":159,"offset":5851}},"kind":"generated","original":{"end":{"column":97,"line":22,"offset":977},"start":{"column":85,"line":22,"offset":965}}},{"generated":{"end":{"column":1,"line":161,"offset":5902},"start":{"column":1,"line":160,"offset":5875}},"kind":"generated","original":{"end":{"column":14,"line":31,"offset":1468},"start":{"column":20,"line":17,"offset":451}}}],"sourceContent":"@tool\nextends Node2D\nconst Probe2D = preload(\"res://examples/node_proof/probe_2d.gd\")\nconst Probe3D = preload(\"res://examples/node_proof/probe_3d.gd\")\n\n@export var palette: Gradient = Gradient.new()\nvar evaluations: Array[String] = []\nvar ticks: int = 0\nvar changes: int = 0\nvar _observed_palette: Gradient\n\nfunc value(label: String, number: float) -> float:\n    evaluations.append(label)\n    return number\n\nfunc compose() -> void:\n    var subtree := <Node2D name=\"Composition\" position={Vector2(value(\"root\", 40.0), 60.0)}>\n        <Probe2D name=\"Panel\" amount={value(\"custom2d\", 7.0)} palette={palette} position={Vector2(20, 10)}>\n            <Polygon2D name=\"Shape\" polygon={PackedVector2Array([Vector2.ZERO, Vector2(160, 0), Vector2(160, 90), Vector2(0, 90)])} color={Color(0.25, 0.8, 0.6)} />\n            <Node2D name=\"Nested2D\" position={Vector2(3, 4)} />\n        </Probe2D>\n        <Timer name=\"Pulse\" wait_time={value(\"timer\", 0.5)} one_shot={true} timeout={on_timeout} />\n        <Node name=\"Boundary\">\n            <Node2D name=\"Reset2D\" position={Vector2(5, 6)} />\n            <Probe3D name=\"Space\" amount={value(\"custom3d\", 9.0)} position={Vector3(10, 20, 30)}>\n                <Node3D name=\"Nested3D\" position={Vector3(1, 2, 3)} />\n                <MeshInstance3D name=\"Mesh\" mesh={BoxMesh.new()} />\n                <Node name=\"ResetBoundary\"><Node3D name=\"Reset3D\" position={Vector3(4, 5, 6)} /></Node>\n            </Probe3D>\n        </Node>\n    </Node2D>\n    add_child(subtree)\n    # Explicitly persist this newly created composition in the hosting scene.\n    # B1 disallows borrowed/expression children, so this visits only new Nodes.\n    persist_new_subtree(subtree)\n\nfunc persist_new_subtree(node: Node) -> void:\n    node.owner = self\n    for child in node.get_children():\n        persist_new_subtree(child)\n\nfunc _enter_tree() -> void:\n    # Non-Node Object signal source, referenced directly from authored Gogo.\n    # It is an external subscription, deliberately not CONNECT_PERSIST.\n    _observed_palette = palette\n    _observed_palette.changed.connect(on_palette_changed)\n\nfunc _exit_tree() -> void:\n    if _observed_palette != null and _observed_palette.changed.is_connected(on_palette_changed):\n        _observed_palette.changed.disconnect(on_palette_changed)\n    _observed_palette = null\n\nfunc _ready() -> void:\n    if get_child_count() == 0:\n        compose()\n\nfunc on_timeout() -> void:\n    ticks += 1\n    var shape: Polygon2D = get_node(\"Composition/Panel/Shape\")\n    shape.color = Color(0.6, 0.3, 0.9) if ticks % 2 else Color(0.25, 0.8, 0.6)\n    print(\"B1 native Timer.timeout: \", ticks)\n\nfunc on_palette_changed() -> void:\n    changes += 1\n\nfunc _unhandled_key_input(event: InputEvent) -> void:\n    if event.is_action_pressed(\"ui_accept\"):\n        get_node(\"Composition/Pulse\").start()\n","sourceName":"res://examples/node_proof/.proof/Composition.gogo","version":1}
