extends Node2D
const Entry = preload("res://addons/estragon/runtime/node/estragon_2d.gd")
const VBox2D = preload("res://addons/estragon/runtime/node/vbox_2d.gd")
const HBox2D = preload("res://addons/estragon/runtime/node/hbox_2d.gd")
const Rect2D = preload("res://addons/estragon/runtime/node/rect_2d.gd")
const Text2D = preload("res://addons/estragon/runtime/node/text_2d.gd")
const Button2D = preload("res://addons/estragon/runtime/node/button_2d.gd")
var count: int = 0
var ui: Node

func _ready() -> void:
    ui = get_node_or_null("UI")
    if ui == null:
        ui = build_view()
        add_child(ui)
        persist(ui)
    refresh()
    if OS.get_environment("ESTRAGON_C3_PROOF") == "1": write_proof.call_deferred()

func build_view() -> Node:
    return <Entry name="UI" position={Vector2(24,24)} viewport_width_scale={0.9}>
        <VBox2D name="Panel" fill_width={true} gap={16.0}>
            <Rect2D name="Accent" height={8.0} fill_width={true} fill={Color(0.2,0.8,0.6)} />
            <Text2D name="Title" text="Estragon native Gogo Counter" font_size={28} color={Color(0.74,0.64,0.94)} />
            <Text2D name="Count" text="Count: 0" font_size={26} />
            <HBox2D name="Actions" fill_width={true} gap={12.0}>
                <Button2D name="Increment" text="+" fill_width={true} pressed={increment} />
                <Button2D name="Reset" text="Reset" fill_width={true} disabled={true} pressed={reset_count} />
            </HBox2D>
            <VBox2D name="Details" fill_width={true} gap={6.0}>
                <Text2D name="Hint" text="Click + to update retained Nodes." font_size={18} />
                <Text2D name="Resize" text="Resize the window: nested native stacks reflow." font_size={18} />
            </VBox2D>
        </VBox2D>
    </Entry>

func persist(node: Node) -> void:
    node.owner = self
    for child in node.get_children(): persist(child)

func increment() -> void:
    count += 1
    refresh()

func reset_count() -> void:
    count = 0
    refresh()

func refresh() -> void:
    ui.get_node("Panel/Count").text = "Count: %d" % count
    ui.get_node("Panel/Actions/Reset").disabled = count == 0

func write_proof() -> void:
    await get_tree().process_frame
    await get_tree().process_frame
    var file := FileAccess.open("res://.godot/c3-play.json",FileAccess.WRITE)
    file.store_string(JSON.stringify({"count":count,"text":ui.get_node("Panel/Count").text,"native":ui.get_layout_root()==ui}))
