r2.ZERO,Vector2(90,0),Vector2(90,60),Vector2(0,60)])} color={Color(0.55,0.35,0.9)} />\n        </Native>\n        <Timer name=\"Pulse\" one_shot={true} timeout={on_timeout} />\n        <Custom name=\"Custom\" amount={value(\"custom\",7)} palette={palette} position={Vector2(10,150)}>\n            <Node2D name=\"Nested\" position={Vector2(3,4)} />\n        </Custom>\n    </Entry>\n\nfunc _enter_tree() -> void:\n    dimension = 2\n    palette.changed.connect(on_palette_changed)\n\nfunc _exit_tree() -> void:\n    if palette.changed.is_connected(on_palette_changed): palette.changed.disconnect(on_palette_changed)\n\n","sourceName":"examples/ggx/TwoD.gogo","version":1}
